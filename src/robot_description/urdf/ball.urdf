<?xml version="1.0" encoding="utf-8"?>
<robot name="ball">
  <!-- Yellow soccer ball -->
  <link name="ball">
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <geometry>
        <sphere radius="0.11"/>
      </geometry>
      <material name="yellow">
        <color rgba="1.0 0.84 0.0 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.11"/>
      </geometry>
    </collision>
  </link>

  <!-- Gazebo: ball visual material -->
  <gazebo reference="ball">
    <visual>
      <material>
        <ambient>1.0 0.84 0.0 1</ambient>
        <diffuse>1.0 0.84 0.0 1</diffuse>
        <specular>0.3 0.3 0.3 1</specular>
      </material>
    </visual>
  </gazebo>
</robot>
